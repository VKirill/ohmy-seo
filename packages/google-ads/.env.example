# 32 hex bytes, generate via `openssl rand -hex 32`. Required.
MCP_GOOGLE_ADS_MASTER_KEY=<placeholder>

# optional, default ./data/state.db
MCP_GOOGLE_ADS_DB_PATH=./data/state.db

# Cache TTL for report results (seconds); default 1 hour
MCP_GOOGLE_ADS_CACHE_TTL_REPORT=3600

# Cache TTL for property/dimension/metric listings (seconds); default 24 hours
MCP_GOOGLE_ADS_CACHE_TTL_META=86400

# Loopback port for OAuth redirect (default 8767)
MCP_GOOGLE_ADS_OAUTH_LOOPBACK_PORT=8767

# --- Google Ads API ---

# Legacy developer token (optional; sunset by Google on 2026-09-09 and ignored by current API)
GOOGLE_ADS_DEVELOPER_TOKEN=

# MCC (manager account) id without dashes, sent as login-customer-id (optional)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Set to "true" to allow any real mutation. Default: every write is preview/validate-only.
GOOGLE_ADS_ALLOW_LIVE_MUTATIONS=false
