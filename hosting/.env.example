# ---------------------------------------------------------------------------
# Copy to .env and fill in. The encryption key lives in a separate file;
# see OPERATIONS.md before creating or migrating a deployment.
# ---------------------------------------------------------------------------

APP_URL=https://ohmy-seo.ru
MCP_PUBLIC_URL=https://mcp.ohmy-seo.ru/mcp

# openssl rand -hex 32  — encrypts every stored third-party token.
# Losing it makes all stored tokens unrecoverable and forces every user to
# re-authorise; back it up separately from the database.
OHMY_SEO_MASTER_KEY_SOURCE=./secrets/ohmy_master

# openssl rand -hex 32  — signs session cookies.
SESSION_SECRET=

# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=ohmy_seo
POSTGRES_DB=ohmy_seo

# oauth.yandex.ru — redirect URI: ${APP_URL}/api/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# console.cloud.google.com — redirect URI: ${APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform-funded SERP tools shared by all users. Leave false unless you intend
# to pay for every user's Mutagen and XMLStock calls out of your own balance.
ENABLE_SHARED_SERP=false
MUTAGEN_API_KEY=
XMLSTOCK_USER=
XMLSTOCK_KEY=

# Write access to live ad accounts. Empty = read-only for the whole platform.
OHMY_SEO_ALLOW_LIVE_MUTATIONS=
YANDEX_DIRECT_ALLOW_LIVE_MUTATIONS=

# Host ports Angie proxies to.
WEB_PORT=3300
GATEWAY_PORT=3301

# Git ref of VKirill/ohmy-seo baked into the gateway image.
OHMY_SEO_REF=v0.9.7

# Separate Yandex data app: required for new working-account connections.
# Register with redirect https://oauth.yandex.ru/verification_code and all
# YANDEX_API_SCOPES from apps/web/src/lib/providers.ts. Keep empty until ready.
YANDEX_API_CLIENT_ID=
YANDEX_API_CLIENT_SECRET=

# Set after approval and a successful production Direct API check for the new ID.
YANDEX_API_DIRECT_READY=false

# Cabinet sign-in uses YANDEX_CLIENT_ID / YANDEX_CLIENT_SECRET with only
# login:info + login:email. Redirect: ${APP_URL}/api/oauth/yandex/callback.
# Working accounts are connected AFTER sign-in via the separate data app:
# YANDEX_API_CLIENT_ID / YANDEX_API_CLIENT_SECRET (configured above).
